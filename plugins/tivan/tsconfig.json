{
  "compilerOptions": {
    "target": "ES2022",
    // agent-wallet ships ESM d.ts with extensionless relative imports, which Node16 resolution rejects.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
