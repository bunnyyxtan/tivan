{
  "name": "mm-plugin-tivan",
  "version": "0.1.0",
  "description": "MetaMask Agent Wallet plugin: trade graded trading cards on Tivan's Kuru order books on Monad",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet",
    "monad",
    "kuru"
  ],
  "files": [
    "dist",
    "oclif.manifest.json",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && oclif manifest",
    "test": "node test/logic.test.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^6.2.0",
    "capabilities": [],
    "commands": [
      {
        "id": "tivan:markets",
        "capabilities": [],
        "dataAccess": []
      },
      {
        "id": "tivan:orders",
        "capabilities": [],
        "dataAccess": []
      },
      {
        "id": "tivan:buy",
        "capabilities": [
          "wallet-submit"
        ],
        "dataAccess": []
      }
    ]
  },
  "dependencies": {
    "viem": "^2.57.3"
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^6.2.0"
  },
  "devDependencies": {
    "@metamask/agent-sdk": "^7.1.0",
    "@metamask/agent-wallet": "^6.2.0",
    "@oclif/core": "^4",
    "oclif": "^4",
    "typescript": "^5"
  }
}
