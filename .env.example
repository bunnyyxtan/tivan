# Testnet key that signs attest/custody and funds the gas drip (attestor). Never commit the real file.
DEPLOYER_KEY=
# Optional: PSA API bearer token. Without it, certs are checked against cre/fixtures/psa-certs.json (testnet only).
PSA_TOKEN=
# Mainnet only: gates the custody endpoint.
CUSTODY_TOKEN=

# --- web app (VITE_*) ---
# WARNING: every VITE_ var is compiled into the public bundle and is readable by anyone who loads the site.
# These are not secrets. If VITE_RPC_URL is a paid endpoint whose key sits in the URL (Quicknode, Alchemy,
# Infura), that key is public and its credit is public too: use a free or rate-capped endpoint here, or put a
# proxy in front of the paid one. Never paste a key you care about.
VITE_RPC_URL=
VITE_RPC_LIMIT=
VITE_RPC_LOGS=
VITE_ATTESTOR_URL=
VITE_INDEXER_URL=
